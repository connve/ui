{
	"name": "@connve/ui",
	"version": "0.1.0",
	"description": "Svelte components and theme shared by the CONNVE apps.",
	"license": "MPL-2.0",
	"type": "module",
	"keywords": [
		"svelte",
		"svelte5",
		"components",
		"tailwindcss",
		"daisyui"
	],
	"homepage": "https://github.com/connve/ui#readme",
	"bugs": "https://github.com/connve/ui/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/connve/ui.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run package",
		"package": "svelte-kit sync && svelte-package && publint && node scripts/check-dist.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"icons": "node scripts/icons.js && prettier --write src/lib/icons.ts",
		"prepublishOnly": "npm run package"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./theme.css": "./dist/theme.css"
	},
	"peerDependencies": {
		"@iconify/svelte": "^5.0.0",
		"daisyui": "^5.0.0",
		"svelte": "^5.40.0",
		"tailwindcss": "^4.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@iconify-json/tabler": "^1.2.44",
		"@iconify/svelte": "^5.2.4",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"daisyui": "^5.7.50",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.25",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	}
}
